# Cloudflare secrets (get from Cloudflare dashboard)
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Vercel secrets (get from Vercel dashboard)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_org_id_here
VERCEL_PROJECT_ID=your_project_id_here

# Admin panel secret (generate a secure random string)
ADMIN_SECRET=your_secure_secret_here

# Pages deployment URL
PAGES_URL=https://bste.pages.dev
