{
  "name": "bste",
  "type": "module",
  "version": "1.0.0",
  "description": "Multi-domain Astro platform for 10+ websites",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=bste",
    "deploy:router": "wrangler deploy --config wrangler-worker.toml",
    "deploy:admin": "wrangler deploy --config wrangler-admin.toml",
    "deploy:all": "npm run deploy:pages && npm run deploy:router && npm run deploy:admin",
    "logs:router": "wrangler tail bste-router",
    "logs:admin": "wrangler tail bste-admin"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-i18n-aut": "^0.8.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
