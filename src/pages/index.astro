---
import Layout from "@layouts/Layout.astro";

// Get domain from URL or default to first domain
const currentDomain = Astro.url.hostname;

// Load domain config
import domainsConfig from '../config/domains.json';
const domainConfig = domainsConfig.domains.find(d => d.domain === currentDomain) || domainsConfig.domains[0];

// Load products for this domain
let products = [];
try {
  const productData = await import(`../content/${domainConfig.id}/products.json`);
  products = productData.default || [];
} catch (e) {
  console.error('Error loading products:', e);
}

// Sort by rank or score
products.sort((a, b) => (a.rank || 0) - (b.rank || 0));
const topProduct = products[0];

const categoryName = domainConfig.category_nl || domainConfig.category || 'producten';
const currentMonth = new Date().toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' });

// Serialize products for JavaScript
const productsJson = JSON.stringify(products);
---

<Layout title={domainConfig.meta?.title || domainConfig.domain}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-sand to-background pb-12 pt-24">
    <div class="container mx-auto max-w-5xl px-4">
      <!-- Header -->
      <div class="mb-12 text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm text-muted-foreground">
          <span>Testdata-overzicht, editie 2026</span>
        </div>
        <h1 class="font-display text-4xl text-ink md:text-6xl lg:text-7xl mb-6">
          {categoryName} Consumentenbond: de volledige ranglijst 2026
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-8">
          Wij verzamelen de officiële testresultaten van de Consumentenbond voor alle geteste {categoryName.toLowerCase()} 
          en presenteren ze in één doorzoekbaar overzicht.
        </p>

        <!-- Quick Stats -->
        <div class="grid grid-cols-3 gap-4 max-w-2xl mx-auto">
          <div class="rounded-xl border border-border bg-card p-4">
            <div class="font-display text-3xl text-primary mb-1">{products.length}</div>
            <div class="text-xs text-muted-foreground">Geteste modellen</div>
          </div>
          <div class="rounded-xl border border-border bg-card p-4">
            <div class="font-display text-3xl text-primary mb-1">2026</div>
            <div class="text-xs text-muted-foreground">Nieuwste editie</div>
          </div>
          <div class="rounded-xl border border-border bg-card p-4">
            <div class="font-display text-3xl text-primary mb-1">✓</div>
            <div class="text-xs text-muted-foreground">Onafhankelijk</div>
          </div>
        </div>
      </div>

      <!-- Top Pick Card -->
      {topProduct && (
        <div class="mb-16 rounded-2xl border border-border bg-gradient-to-br from-primary/5 to-accent/5 p-8">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary px-4 py-1.5 text-sm font-medium text-primary-foreground">
            🏆 Beste Koop 2026
          </div>
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="font-display text-3xl text-ink mb-3 md:text-4xl">
                {topProduct.header?.brand} {topProduct.header?.type}
              </h2>
              <div class="mb-6 flex items-baseline gap-2">
                <span class="font-display text-6xl text-primary">
                  {topProduct.testresults?.ratingDisplayValue || 'N/A'}
                </span>
                <span class="text-muted-foreground">/ 10</span>
              </div>
              <p class="text-muted-foreground mb-6 leading-relaxed">
                {topProduct.summary?.description || 'Beste getest in deze categorie volgens Consumentenbond.'}
              </p>
              <a 
                href={`/out/top-${domainConfig.id}`}
                target="_blank"
                rel="nofollow"
                class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-medium text-primary-foreground transition hover:bg-primary/90"
              >
                Bekijk beste prijs →
              </a>
            </div>
            <div class="space-y-4">
              <div class="rounded-xl border border-border bg-card p-6">
                <div class="text-sm text-muted-foreground mb-2">Prijs</div>
                <div class="font-display text-3xl text-ink">{topProduct.price || 'N/A'}</div>
              </div>
              <div class="rounded-xl border border-border bg-card p-6">
                <div class="text-sm text-muted-foreground mb-2">Testoordeel</div>
                <div class="font-display text-3xl text-primary">{topProduct.testresults?.ratingDisplayValue || 'N/A'}</div>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Full Table Section -->
      <div class="mb-16">
        <div class="mb-8">
          <p class="text-xs font-medium uppercase tracking-wide text-primary mb-2">Volledige ranglijst</p>
          <h2 class="font-display text-2xl text-ink md:text-3xl mb-2">
            Alle {products.length} {categoryName.toLowerCase()} op een rij
          </h2>
          <p class="text-xs text-muted-foreground mb-6">
            Sorteer en filter direct in de tabel
          </p>
        </div>

        <!-- Filter/Sort Controls -->
        <div class="mb-6 grid gap-4 md:grid-cols-4">
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Zoeken</label>
            <input 
              type="text" 
              id="searchInput"
              placeholder="Zoek model..."
              class="w-full rounded-lg border border-border bg-card px-4 py-2 text-sm focus:ring-2 focus:ring-primary"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Sorteer op</label>
            <select 
              id="sortSelect"
              class="w-full rounded-lg border border-border bg-card px-4 py-2 text-sm focus:ring-2 focus:ring-primary"
            >
              <option value="rank">Rangorde</option>
              <option value="score-desc">Score (hoog-laag)</option>
              <option value="score-asc">Score (laag-hoog)</option>
              <option value="price-asc">Prijs (laag-hoog)</option>
              <option value="price-desc">Prijs (hoog-laag)</option>
              <option value="brand">Merk (A-Z)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Filter Merk</label>
            <select 
              id="brandFilter"
              class="w-full rounded-lg border border-border bg-card px-4 py-2 text-sm focus:ring-2 focus:ring-primary"
            >
              <option value="">Alle merken</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Min. Score</label>
            <select 
              id="scoreFilter"
              class="w-full rounded-lg border border-border bg-card px-4 py-2 text-sm focus:ring-2 focus:ring-primary"
            >
              <option value="0">Alle scores</option>
              <option value="6">6.0+</option>
              <option value="7">7.0+</option>
              <option value="8">8.0+</option>
              <option value="9">9.0+</option>
            </select>
          </div>
        </div>

        <!-- Products Table -->
        <div class="rounded-xl border border-border bg-card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="border-b border-border bg-muted/50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">#</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">Model</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">Score</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">Prijs</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground"></th>
                </tr>
              </thead>
              <tbody id="productsTableBody" class="divide-y divide-border">
                <!-- Products will be inserted by JavaScript -->
              </tbody>
            </table>
          </div>
        </div>

        <div id="noResults" class="hidden text-center py-12 text-muted-foreground">
          Geen producten gevonden met deze filters.
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mb-16">
        <div class="mb-8">
          <p class="text-xs font-medium uppercase tracking-wide text-primary mb-2">Veelgesteld</p>
          <h2 class="font-display text-2xl text-ink md:text-3xl">
            Veelgestelde vragen
          </h2>
        </div>
        <div class="space-y-4">
          <details class="group rounded-xl border border-border bg-card p-6">
            <summary class="cursor-pointer font-medium text-ink list-none">
              <span class="flex items-center justify-between">
                Wat is de beste {categoryName.toLowerCase()} van 2026?
                <span class="text-muted-foreground">+</span>
              </span>
            </summary>
            <p class="mt-4 text-muted-foreground leading-relaxed">
              Op basis van de Consumentenbond testresultaten komt de {topProduct?.header?.brand} {topProduct?.header?.type} 
              als beste uit de test met een testoordeel van {topProduct?.testresults?.ratingDisplayValue || 'N/A'}.
            </p>
          </details>

          <details class="group rounded-xl border border-border bg-card p-6">
            <summary class="cursor-pointer font-medium text-ink list-none">
              <span class="flex items-center justify-between">
                Hoe vaak worden de testresultaten bijgewerkt?
                <span class="text-muted-foreground">+</span>
              </span>
            </summary>
            <p class="mt-4 text-muted-foreground leading-relaxed">
              Wij updaten deze vergelijking maandelijks met de nieuwste testresultaten van de Consumentenbond.
            </p>
          </details>

          <details class="group rounded-xl border border-border bg-card p-6">
            <summary class="cursor-pointer font-medium text-ink list-none">
              <span class="flex items-center justify-between">
                Zijn jullie onderdeel van de Consumentenbond?
                <span class="text-muted-foreground">+</span>
              </span>
            </summary>
            <p class="mt-4 text-muted-foreground leading-relaxed">
              Nee, De Test Experts! is onafhankelijk. Wij verzamelen publiek beschikbare testresultaten 
              en presenteren ze overzichtelijk.
            </p>
          </details>

          <details class="group rounded-xl border border-border bg-card p-6">
            <summary class="cursor-pointer font-medium text-ink list-none">
              <span class="flex items-center justify-between">
                Waar komen de prijzen vandaan?
                <span class="text-muted-foreground">+</span>
              </span>
            </summary>
            <p class="mt-4 text-muted-foreground leading-relaxed">
              De prijzen zijn gebaseerd op publieke prijsinformatie en worden regelmatig geüpdatet. 
              Klik op "Bekijk prijs" voor de actuele prijs bij onze partnerretailers.
            </p>
          </details>
        </div>
      </div>

      <!-- Disclaimer -->
      <div class="rounded-xl border border-border bg-muted/50 p-6">
        <p class="text-sm text-muted-foreground leading-relaxed">
          <strong class="text-ink">Onafhankelijke disclaimer:</strong> De Test Experts! is op geen enkele manier verbonden aan 
          of een partner van de Consumentenbond. Wij vatten hun publiek beschikbare testresultaten samen en 
          verwijzen voor het lidmaatschap en de volledige rapporten naar 
          <a href="https://www.consumentenbond.nl/" target="_blank" rel="nofollow" class="text-primary hover:underline">
            consumentenbond.nl
          </a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border bg-card py-12">
    <div class="container mx-auto max-w-5xl px-4">
      <div class="grid gap-8 md:grid-cols-4">
        <div>
          <div class="font-display text-xl text-ink mb-3">De Test Experts!</div>
          <p class="text-sm text-muted-foreground">
            Onafhankelijk analyseplatform voor {categoryName.toLowerCase()} in Nederland.
          </p>
        </div>
        <div>
          <h3 class="font-medium text-ink mb-3">Navigatie</h3>
          <div class="space-y-2 text-sm">
            <a href="#" class="block text-muted-foreground hover:text-ink transition">Ranglijst</a>
            <a href="#" class="block text-muted-foreground hover:text-ink transition">FAQ</a>
            <a href="#" class="block text-muted-foreground hover:text-ink transition">Contact</a>
          </div>
        </div>
        <div>
          <h3 class="font-medium text-ink mb-3">Contact</h3>
          <div class="space-y-2 text-sm text-muted-foreground">
            <div>Keizersgracht 482</div>
            <div>1017 EG Amsterdam</div>
            <div>redactie@testexperts.nl</div>
          </div>
        </div>
        <div>
          <h3 class="font-medium text-ink mb-3">Databron</h3>
          <p class="text-sm text-muted-foreground">
            Alle testdata is eigendom van Consumentenbond.nl
          </p>
        </div>
      </div>
      <div class="mt-8 border-t border-border pt-8 text-center text-sm text-muted-foreground">
        © 2026 De Test Experts! B.V. · Laatste update: {new Date().toLocaleDateString('nl-NL')}
      </div>
    </div>
  </footer>

  <!-- JavaScript for filtering/sorting -->
  <script define:vars={{ products: productsJson, domainId: domainConfig.id }}>
    const allProducts = typeof products === 'string' ? JSON.parse(products) : products;
    let filteredProducts = [...allProducts];

    // Extract unique brands
    const brands = [...new Set(allProducts.map(p => p.header?.brand).filter(Boolean))].sort();
    const brandFilter = document.getElementById('brandFilter');
    brands.forEach(brand => {
      const option = document.createElement('option');
      option.value = brand;
      option.textContent = brand;
      brandFilter.appendChild(option);
    });

    function parsePrice(priceStr) {
      if (!priceStr) return 0;
      return parseFloat(priceStr.replace(/[^0-9.,]/g, '').replace(',', '.')) || 0;
    }

    function parseScore(product) {
      return parseFloat(product.testresults?.ratingDisplayValue) || 0;
    }

    function renderProducts() {
      const tbody = document.getElementById('productsTableBody');
      const noResults = document.getElementById('noResults');
      
      if (filteredProducts.length === 0) {
        tbody.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');
      tbody.innerHTML = filteredProducts.map((product, index) => `
        <tr class="hover:bg-muted/50 transition-colors">
          <td class="px-4 py-4">
            <span class="font-display text-lg text-ink">${index + 1}</span>
          </td>
          <td class="px-4 py-4">
            <div class="flex items-center gap-3">
              ${product.asset?.src ? `<img src="${product.asset.src}" alt="${product.header?.brand}" class="h-12 w-12 object-contain" />` : ''}
              <div>
                <div class="font-medium text-ink">${product.header?.brand || ''}</div>
                <div class="text-sm text-muted-foreground">${product.header?.type || ''}</div>
              </div>
            </div>
          </td>
          <td class="px-4 py-4">
            <div class="font-display text-2xl text-primary">${product.testresults?.ratingDisplayValue || 'N/A'}</div>
          </td>
          <td class="px-4 py-4">
            <div class="font-medium text-ink">${product.price || 'N/A'}</div>
          </td>
          <td class="px-4 py-4">
            <a 
              href="/out/${domainId}-${product.id || index}"
              target="_blank"
              rel="nofollow"
              class="inline-flex items-center gap-1 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:bg-primary/90"
            >
              Bekijk →
            </a>
          </td>
        </tr>
      `).join('');
    }

    function filterAndSort() {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      const sortBy = document.getElementById('sortSelect').value;
      const brandValue = document.getElementById('brandFilter').value;
      const minScore = parseFloat(document.getElementById('scoreFilter').value);

      // Filter
      filteredProducts = allProducts.filter(product => {
        const matchesSearch = !searchTerm || 
          (product.header?.brand || '').toLowerCase().includes(searchTerm) ||
          (product.header?.type || '').toLowerCase().includes(searchTerm);
        
        const matchesBrand = !brandValue || product.header?.brand === brandValue;
        const matchesScore = parseScore(product) >= minScore;

        return matchesSearch && matchesBrand && matchesScore;
      });

      // Sort
      switch(sortBy) {
        case 'rank':
          filteredProducts.sort((a, b) => (a.rank || 0) - (b.rank || 0));
          break;
        case 'score-desc':
          filteredProducts.sort((a, b) => parseScore(b) - parseScore(a));
          break;
        case 'score-asc':
          filteredProducts.sort((a, b) => parseScore(a) - parseScore(b));
          break;
        case 'price-asc':
          filteredProducts.sort((a, b) => parsePrice(a.price) - parsePrice(b.price));
          break;
        case 'price-desc':
          filteredProducts.sort((a, b) => parsePrice(b.price) - parsePrice(a.price));
          break;
        case 'brand':
          filteredProducts.sort((a, b) => (a.header?.brand || '').localeCompare(b.header?.brand || ''));
          break;
      }

      renderProducts();
    }

    // Event listeners
    document.getElementById('searchInput').addEventListener('input', filterAndSort);
    document.getElementById('sortSelect').addEventListener('change', filterAndSort);
    document.getElementById('brandFilter').addEventListener('change', filterAndSort);
    document.getElementById('scoreFilter').addEventListener('change', filterAndSort);

    // Initial render
    filterAndSort();
  </script>
</Layout>
