---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
import Sectionhead from "@components/sectionhead.astro";
import { Icon } from "astro-icon/components";

// Get domain from URL or default to first domain
const currentDomain = Astro.url.hostname;

// Load domain config
import domainsConfig from '../config/domains.json';
const domainConfig = domainsConfig.domains.find(d => d.domain === currentDomain) || domainsConfig.domains[0];

// Load products for this domain
let products = [];
try {
  const productData = await import(`../content/${domainConfig.id}/products.json`);
  products = productData.default || [];
} catch (e) {
  console.error('Error loading products:', e);
}

// Sort by rank or score
products.sort((a, b) => (a.rank || 0) - (b.rank || 0));
const topProduct = products[0];
---

<Layout title={domainConfig.meta?.title || domainConfig.domain}>
  <Container>
    <!-- Hero Section -->
    <div class="mt-16 md:mt-24">
      <Sectionhead>
        <Fragment slot="badge">Consumentenbond Test 2026</Fragment>
        <Fragment slot="title">
          {domainConfig.category_nl || domainConfig.category} Vergelijking
        </Fragment>
        <Fragment slot="desc">
          Alle {products.length} geteste modellen uit de Consumentenbond test, overzichtelijk vergeleken.
          Onafhankelijke scores, prijzen en specificaties.
        </Fragment>
      </Sectionhead>

      <!-- Stats -->
      <div class="grid md:grid-cols-3 gap-6 mt-12 mb-16">
        <div class="bg-white rounded-xl p-6 shadow-sm text-center border border-gray-100">
          <div class="text-4xl font-bold text-primary mb-2">{products.length}</div>
          <div class="text-gray-600">Geteste modellen</div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm text-center border border-gray-100">
          <div class="text-4xl font-bold text-primary mb-2">2026</div>
          <div class="text-gray-600">Nieuwste editie</div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm text-center border border-gray-100">
          <div class="text-4xl font-bold text-primary mb-2">✓</div>
          <div class="text-gray-600">Onafhankelijk</div>
        </div>
      </div>
    </div>

    <!-- Top Pick -->
    {topProduct && (
      <div class="my-16">
        <div class="bg-gradient-to-br from-green-50 to-primary/5 rounded-2xl p-8 border-2 border-green-200">
          <div class="flex items-center gap-3 mb-6">
            <span class="bg-green-500 text-white px-4 py-2 rounded-full font-bold text-sm">
              🏆 Beste Koop 2026
            </span>
          </div>
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="text-3xl md:text-4xl font-bold mb-3">
                {topProduct.header?.brand} {topProduct.header?.type}
              </h2>
              <div class="flex items-baseline gap-2 mb-6">
                <span class="text-6xl font-bold text-green-600">
                  {topProduct.testresults?.ratingDisplayValue || 'N/A'}
                </span>
                <span class="text-gray-600">/ 10</span>
              </div>
              <p class="text-gray-700 mb-6 leading-relaxed">
                {topProduct.summary?.description || 'Beste getest in deze categorie volgens Consumentenbond.'}
              </p>
              <a 
                href={`/out/top-${domainConfig.id}`}
                target="_blank"
                rel="nofollow"
                class="inline-flex items-center gap-2 bg-green-600 text-white px-8 py-4 rounded-lg hover:bg-green-700 font-bold transition"
              >
                Bekijk beste prijs
                <Icon name="bx:bx-right-arrow-alt" class="w-5 h-5" />
              </a>
            </div>
            <div class="space-y-4">
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <div class="text-sm text-gray-600 mb-1">Prijs</div>
                <div class="text-3xl font-bold text-gray-900">{topProduct.price || 'N/A'}</div>
              </div>
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <div class="text-sm text-gray-600 mb-1">Shops</div>
                <div class="text-3xl font-bold text-gray-900">{topProduct.shops || '1'}+ beschikbaar</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Comparison Table -->
    <div class="my-16">
      <h2 class="text-3xl font-bold mb-8">Volledige vergelijking: alle {products.length} modellen</h2>
      
      <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-200">
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">#</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Model</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Score</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Prijs</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {products.map((product, index) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4">
                    <span class="text-lg font-bold text-gray-900">{index + 1}</span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-4">
                      {product.asset?.src && (
                        <img 
                          src={product.asset.src} 
                          alt={product.header?.brand}
                          class="w-16 h-16 object-contain"
                        />
                      )}
                      <div>
                        <div class="font-bold text-gray-900">
                          {product.header?.brand}
                        </div>
                        <div class="text-sm text-gray-600">
                          {product.header?.type}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-2xl font-bold text-primary">
                      {product.testresults?.ratingDisplayValue || 'N/A'}
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="font-bold text-gray-900">
                      {product.price || 'N/A'}
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <a 
                      href={`/out/${domainConfig.id}-${product.id || index}`}
                      target="_blank"
                      rel="nofollow"
                      class="inline-flex items-center gap-2 bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary/90 transition text-sm font-medium"
                    >
                      Bekijk prijs
                      <Icon name="bx:bx-right-arrow-alt" class="w-4 h-4" />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="my-16">
      <h2 class="text-3xl font-bold mb-8">Veelgestelde vragen</h2>
      <div class="space-y-4">
        <details class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <summary class="font-bold text-lg cursor-pointer text-gray-900">
            Wat is de beste {(domainConfig.category_nl || domainConfig.category || '').toLowerCase()} van 2026?
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Op basis van de Consumentenbond testresultaten komt de {topProduct?.header?.brand} {topProduct?.header?.type} 
            als beste uit de test met een testoordeel van {topProduct?.testresults?.ratingDisplayValue || 'N/A'}.
          </p>
        </details>

        <details class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <summary class="font-bold text-lg cursor-pointer text-gray-900">
            Hoe vaak worden de testresultaten bijgewerkt?
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Wij updaten deze vergelijking maandelijks met de nieuwste testresultaten van de Consumentenbond.
          </p>
        </details>

        <details class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <summary class="font-bold text-lg cursor-pointer text-gray-900">
            Zijn jullie onderdeel van de Consumentenbond?
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Nee, De Test Experts! is onafhankelijk. Wij verzamelen publiek beschikbare testresultaten 
            en presenteren ze overzichtelijk.
          </p>
        </details>

        <details class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <summary class="font-bold text-lg cursor-pointer text-gray-900">
            Waar komen de prijzen vandaan?
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            De prijzen zijn gebaseerd op publieke prijsinformatie en worden regelmatig geüpdatet. 
            Klik op "Bekijk prijs" voor de actuele prijs bij onze partnerretailers.
          </p>
        </details>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="my-16 bg-gray-50 rounded-xl p-8 border border-gray-200">
      <p class="text-sm text-gray-600 leading-relaxed">
        <strong>Onafhankelijke disclaimer:</strong> De Test Experts! is op geen enkele manier verbonden aan 
        of een partner van de Consumentenbond. Wij vatten hun publiek beschikbare testresultaten samen en 
        verwijzen voor het lidmaatschap en de volledige rapporten naar 
        <a href="https://www.consumentenbond.nl/" target="_blank" rel="nofollow" class="text-primary hover:underline">
          consumentenbond.nl
        </a>.
      </p>
    </div>
  </Container>
</Layout>
